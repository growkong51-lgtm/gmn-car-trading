rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can VIEW the vehicle listings (needed for the public website).
    // Only a signed-in admin (you) can add, edit, or delete listings.
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anyone can SUBMIT an inquiry (needed for the public contact form).
    // Only a signed-in admin (you) can view, update (mark read), or delete leads.
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
